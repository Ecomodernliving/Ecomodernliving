# Site
NEXT_PUBLIC_SITE_URL=https://ecomodernliving.ai
NEXT_PUBLIC_CONTACT_EMAIL=hello@ecomodernliving.ai
# Shown in email footers (CAN-SPAM). Prefer a real postal / PO Box address.
NEXT_PUBLIC_MAILING_ADDRESS=EcoModern Living · hello@ecomodernliving.ai · United States

# Auth — REQUIRED in production. Set a long random string (e.g. openssl rand -base64 32).
# If unset, a known default is used and ANYONE could forge an admin session.
AUTH_SECRET=

# Marketplace admin (can edit Top Picks products when signed in)
ADMIN_EMAIL=ecomodernliving@gmail.com

# Database (Neon / Vercel Postgres) — REQUIRED for sign up / login and for
# adding/editing marketplace products to work on the deployed site.
# Auto-added when you connect a Postgres store in the Vercel dashboard.
# Without it, the app falls back to local JSON files (dev only; not on Vercel).
DATABASE_URL=

# Image uploads (Vercel Blob) — lets admins upload product images on the live site.
# Auto-added when you connect a Blob store in the Vercel dashboard (Storage → Blob).
# Without it, uploads fall back to the local public/ folder (dev only; not on Vercel).
BLOB_READ_WRITE_TOKEN=

# Transactional email via Resend (https://resend.com) — REQUIRED to email subscribers
# a newsletter confirmation and to auto-email energy audit estimates.
# 1) Create an API key at resend.com
# 2) Verify your sending domain (or use onboarding@resend.dev for tests to your own inbox)
RESEND_API_KEY=
RESEND_FROM_EMAIL=EcoModern Living <hello@ecomodernliving.ai>

# Weekly newsletter cron (Vercel Cron)
# Generate with: openssl rand -hex 32
# Saturday 15:00 UTC → compose draft | Monday 14:00 UTC → send approved only
CRON_SECRET=

# Airtable — primary store for newsletter issues (Phase 1 + n8n)
# 1) Create a base + table named "Newsletter Issues" (or set AIRTABLE_NEWSLETTER_TABLE)
# 2) Fields (exact names):
#    Issue ID, Subject, Preview Text, Status (draft|pending_approval|approved|sent),
#    Eco Product Picks, AI Smart Home Trends, Energy Saving Tips, Passive House Education
#      (Long text — JSON), Source Payload (Long text — JSON), Used ASINs, FAQ ID,
#    Week Key, Scheduled For, Sent At, Approved At, Created At (Date or text)
# 3) Create a PAT with data.records:read + data.records:write on that base
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_NEWSLETTER_TABLE=Newsletter Issues

# Optional n8n integration
# Outbound: we POST draft/approve/publish events here for LLM/RAG enrichment
N8N_NEWSLETTER_WEBHOOK_URL=
# Inbound: n8n calls POST /api/hooks/newsletter with Bearer token
# Actions: compose | update | approve | publish
NEWSLETTER_HOOK_SECRET=

# Amazon Associates tag (e.g. ecomodernliving-20)
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# Formspree form IDs (bare ID e.g. mbdvljqr, or full https://formspree.io/f/... URL)
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=
NEXT_PUBLIC_FORMSPREE_NEWSLETTER_ID=
NEXT_PUBLIC_FORMSPREE_AUDIT_ID=

# Google Sheet product catalog (optional — lets non-technical users edit products in a spreadsheet)
# Publish sheet: File → Share → Publish to web → CSV → copy URL here
MARKETPLACE_SHEET_CSV_URL=

NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@ecomodernliving
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/ecomodernliving
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/ecomodernliving
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/ecomodernliving
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@ecomodernliving
NEXT_PUBLIC_PINTEREST_URL=https://www.pinterest.com/ecomodernliving
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/ecomodernliving
